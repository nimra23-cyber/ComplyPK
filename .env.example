# ComplyPK environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# REQUIRED. Exact origin of the frontend app permitted by CORS.
# The backend fails to start if this is unset.
# Example: http://localhost:5173
ALLOWED_FRONTEND_ORIGIN=http://localhost:5173

# OPTIONAL. Database connection string.
# When unset, the backend defaults to a local SQLite database.
# PostgreSQL example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# OPTIONAL. Credential for the external LLM API used for remediation plans.
# When unset, the backend uses the template-based fallback generator.
LLM_API_KEY=
# OPTIONAL. SMTP settings for sending email invitations and email-verification
# links. If SMTP_HOST or SMTP_FROM is missing, email sending is considered
# UNCONFIGURED: email invitations and verification requests fail clearly (503),
# while shareable invitation links still work. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# OPTIONAL. Groq for AI-generated remediation recommendations.
# Read ONLY by the backend; never exposed to the frontend. When GROQ_API_KEY is
# unset (or any call fails/rate-limits/times out/returns invalid output), the
# backend uses the deterministic template fallback (source="fallback").
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# OPTIONAL. Groq model id. Groq's catalog changes over time — verify your key's
# available models at https://console.groq.com/docs/models and set it here if
# the default is unavailable.
GROQ_MODEL=llama-3.1-8b-instant
